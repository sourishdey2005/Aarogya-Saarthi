{
  "name": "aarogya-saarthi",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "vite --port=5173 --strictPort --host=0.0.0.0",
    "dev:https": "vite --mode https --port=5173 --strictPort --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --port=4173 --strictPort",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.server.json",
    "api:dev": "node --experimental-strip-types server/api.ts",
    "api:start": "node --experimental-strip-types server/api.ts",
    "db:inspect": "node --experimental-strip-types tests/db-inspect.mjs",
    "test:api": "node --experimental-strip-types --test tests/api.test.ts",
    "test:sql": "node --experimental-strip-types tests/sql-seed-and-curl.mjs",
    "test:integration": "node tests/frontend-integration.mjs"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-router-dom": "^7.18.4",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  }
}
