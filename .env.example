# ─────────────────────────────────────────────────────────────
# NVIDIA NIM — AI provider for triage (and any future AI feature)
# Get a key from https://build.nvidia.com
#
# Convex functions read these from the *deployment* environment, not from this
# file. Copy your key into .env and run `npm run env:sync` once, or set them by
# hand:
#   npx convex env set NVIDIA_API_KEY nvapi-...
#   npx convex env set NVIDIA_MODEL nvidia/nemotron-3.5-lightning-30b-a3b
# ─────────────────────────────────────────────────────────────
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
NVIDIA_TEMPERATURE=1
NVIDIA_TOP_P=0.95
NVIDIA_MAX_TOKENS=16384
NVIDIA_REASONING_BUDGET=16384
NVIDIA_ENABLE_THINKING=true

# Vision model used to read prescription photos (Scan screen)
NVIDIA_VISION_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b
NVIDIA_VISION_TEMPERATURE=0.2
NVIDIA_VISION_MAX_TOKENS=4096

# ─────────────────────────────────────────────────────────────
# Convex backend
# The browser bundle embeds the HTTP actions URL in vite.config.ts, so Vercel
# does not need any environment variables. This value is only for reference.
# ─────────────────────────────────────────────────────────────
CONVEX_URL=https://fabulous-magpie-388.convex.site

# Legacy API token (backward compatibility)
VITE_API_TOKEN=
