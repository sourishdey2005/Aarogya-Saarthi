# Convex Database (required)
# Get this from your Convex dashboard: https://dashboard.convex.dev
# Set as CONVEX_URL in Vercel Environment Variables (NOT VITE_ prefix)
CONVEX_URL=https://your-deployment.convex.cloud

# NVIDIA NIM API Key for AI Triage (optional)
# Get from https://build.nvidia.com/explore/discover
NVIDIA_API_KEY=

# Legacy API token (for backward compatibility)
VITE_API_TOKEN=