# ─────────────────────────────────────────────────────────────────────────────
# Aarogya Saarthi - environment variables
# Copy to .env (or .env.local) and fill in the values.
# ─────────────────────────────────────────────────────────────────────────────

# Where the SQLite database file lives. The file (and its schema) is created
# automatically the first time the API starts.
#   Windows : ./data/aarogya.sqlite
#   Linux   : /var/lib/aarogya-saarthi/aarogya.sqlite
SQLITE_PATH=./data/aarogya.sqlite

# Secret used to sign and verify the JWTs of the API requests.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NEON_AUTH_SECRET=replace-with-a-long-random-string

# NVIDIA NIM API key (free tier, 40 requests/minute).
# https://build.nvidia.com -> sign in -> API Keys -> Generate.
NVIDIA_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxxxxxx

# Frontend configuration (Vite exposes VITE_* variables to the browser).
# The URL of the API server.
VITE_API_URL=http://localhost:8787

# Optional: a token used for local development against the API.
# With ALLOW_DEV_AUTH=true the API accepts a plain worker UUID.
VITE_API_TOKEN=00000000-0000-0000-0000-000000000001

# Development only: allows the API to accept a bare UUID as the bearer token
# instead of a signed JWT. NEVER set this in production.
ALLOW_DEV_AUTH=true
DEV_USER_ID=00000000-0000-0000-0000-000000000001

# Port for the API server.
API_PORT=8787
API_HOST=0.0.0.0
