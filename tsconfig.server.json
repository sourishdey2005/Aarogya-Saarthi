{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": false,
    "verbatimModuleSyntax": false
  },
  "include": ["server/**/*.ts", "tests/**/*.ts", "scripts/**/*.mjs"],
  "exclude": ["node_modules", "dist"]
}
